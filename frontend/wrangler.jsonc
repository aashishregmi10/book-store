{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "book-store",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-11-13",
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "book-store"
    }
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  }
}