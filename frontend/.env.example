# Copy to .env.local for development. On Vercel, set these on the frontend
# project (see /DEPLOY.md §3).
#
# Anything prefixed NEXT_PUBLIC_ is inlined into the browser bundle and is
# therefore PUBLIC — never put a secret behind that prefix.

# ── API ──────────────────────────────────────────────────
# Both must include the trailing /api — the clients append paths like /books
# straight onto this base.
API_URL=http://localhost:5000/api                 # server-side (SSR) fetches
NEXT_PUBLIC_API_URL=http://localhost:5000/api     # browser fetches

# ── Site ─────────────────────────────────────────────────
# Drives metadataBase, canonicals, sitemap and JSON-LD. No trailing slash.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Google Sign-In ───────────────────────────────────────
# The public Web client ID; must match the backend's GOOGLE_CLIENT_ID.
# The deployed domain has to be listed under the OAuth client's
# "Authorized JavaScript origins" or the button silently fails to render.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# ── Contact details ──────────────────────────────────────
# Shown on /contact. Leave blank to hide the phone row entirely rather than
# publish a number that doesn't work. E.164, e.g. +9779801234567
NEXT_PUBLIC_CONTACT_PHONE=

# ── Analytics (optional) ─────────────────────────────────
# Set on the Production environment ONLY, so preview deploys and local work
# stay out of the property. Nothing renders without it.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# ── Search console verification (optional) ───────────────
NEXT_PUBLIC_GSC_VERIFICATION=
NEXT_PUBLIC_BING_VERIFICATION=

# ── Rate-limit exemption (optional) ──────────────────────
# Must match INTERNAL_API_KEY on the backend. Server-only (no NEXT_PUBLIC_
# prefix) so it never reaches the browser. Lets our SSR fetches bypass the
# API's IP-keyed limiter, which otherwise counts every shopper's page render
# against one shared Vercel egress address.
INTERNAL_API_KEY=
