# ── Server ───────────────────────────────────────────────
PORT=5000
NODE_ENV=development
# Comma-separated list of origins allowed by CORS + Socket.io. The FIRST one
# is canonical — used to build links in emails, the sitemap, the merchant feed
# and IndexNow — so put the real domain first. List more than one while a
# platform (e.g. Vercel) still serves traffic on an old URL alongside a newly
# attached custom domain, or Google Sign-In / any API call from the other
# origin will fail CORS. No trailing slashes.
#   FRONTEND_URL=https://www.bookstemple.com,https://book-store-tawny-two.vercel.app
FRONTEND_URL=http://localhost:3000

# ── MongoDB ──────────────────────────────────────────────
# Local:  mongodb://localhost:27017/bookstemple_nepal
# Atlas:  mongodb+srv://<user>:<password>@<cluster>.mongodb.net/bookstemple_nepal?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/bookstemple_nepal
# Optional. Comma-separated DNS servers for resolving mongodb+srv:// SRV records.
# Set this if Node's resolver is loopback-only (VPN/Docker/local proxy) and
# Atlas connects fail with "querySrv ECONNREFUSED". e.g. 8.8.8.8,1.1.1.1
# DNS_SERVERS=8.8.8.8,1.1.1.1

# ── JWT (generate with: openssl rand -hex 32) ────────────
JWT_SECRET=change-me-min-32-chars
JWT_ACCESS_EXPIRE=15m
# How long a login survives inactivity, in days. Every refresh slides the window
# forward, so an active shopper is never signed out. Admins are capped much
# lower on purpose — that session can edit the catalogue and read addresses.
# (JWT_REFRESH_EXPIRE is no longer read; these two replace it.)
JWT_REFRESH_DAYS=180
JWT_ADMIN_REFRESH_DAYS=7

# ── Redis (optional; app falls back to Mongo if absent) ──
REDIS_URL=redis://localhost:6379

# ── Cloudinary (image upload) ────────────────────────────
# Cloudflare R2 — book cover storage (S3-compatible).
# Public reads go through R2_PUBLIC_BASE and need no key; these are write creds.
R2_ACCOUNT_ID=your-account-id
R2_ACCESS_KEY_ID=your-access-key-id
R2_SECRET_ACCESS_KEY=your-secret-access-key
R2_BUCKET=bookstemple-covers
R2_PUBLIC_BASE=https://your-bucket.r2.dev

# ── Email (Gmail SMTP — use an App Password, not your login) ──
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-gmail-app-password
EMAIL_FROM=Books Temple Nepal <noreply@bookstemplenepal.com>

# ── Google OAuth (Sign in with Google) ──────────────────
# The public Web client ID from Google Cloud Console (only this is needed —
# ID-token verification doesn't use the client secret).
GOOGLE_CLIENT_ID=

# ── Book metadata lookup (Google Books) ─────────────────
# Optional but recommended: the keyless Google Books quota is tiny and 429s under
# load, which breaks bulk lookups. Create a key in Google Cloud Console (Books
# API) and paste it here. Open Library needs no key.
GOOGLE_BOOKS_API_KEY=

# ── New Relic APM (optional; only runs when NODE_ENV=production) ──
NEW_RELIC_LICENSE_KEY=
NEW_RELIC_APP_NAME=Books Temple Nepal API

# ── SEO / IndexNow (generate a random key before prod) ───
INDEXNOW_KEY=

# ── Contact form ─────────────────────────────────────────
# Where notes from /contact are emailed. Messages are also stored in the
# database regardless, so nothing is lost if SMTP is down or unconfigured.
CONTACT_EMAIL=bookstemple01@gmail.com

# ── Security ─────────────────────────────────────────────
# The global limiter keys on IP, and in production nearly all traffic arrives
# from Vercel's egress addresses (the storefront is server-rendered), so every
# shopper shares one bucket. Keep this high — brute-force protection lives on
# the per-action login/register limiters, not here.
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=2000

# Shared secret that exempts our own server-side fetches from the limiter above.
# Set the SAME value here and as INTERNAL_API_KEY on the frontend project.
# Optional — leave blank and the high ceiling carries the load on its own.
# Generate with: openssl rand -hex 32
INTERNAL_API_KEY=

# ── Nepal Can Move (courier) ─────────────────────────────
# Live API: https://portal.nepalcanmove.com  ·  Demo: https://demo.nepalcanmove.com
# (demo = the demo token from the NCM portal and made-up customers only).
NCM_BASE_URL=https://portal.nepalcanmove.com
# From the NCM vendor portal → API section. Server-side only; never commit it.
NCM_API_TOKEN=
# Random secret that NCM's webhook must carry. Set this URL in the NCM portal
# (API section → "Order Delivery Webhook URL"):
#   https://<api-domain>/api/webhooks/ncm?token=<NCM_WEBHOOK_SECRET>
# Generate with: openssl rand -hex 24
NCM_WEBHOOK_SECRET=
# Minutes between status checks — the safety net for webhooks NCM never resends.
# Run it on ONE server only (the deployed API); 0 turns it off.
NCM_SYNC_MINUTES=30
