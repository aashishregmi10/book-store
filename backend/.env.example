# ── Server ───────────────────────────────────────────────
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# ── MongoDB ──────────────────────────────────────────────
# Local:  mongodb://localhost:27017/pageturn_nepal
# Atlas:  mongodb+srv://<user>:<password>@<cluster>.mongodb.net/pageturn_nepal?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/pageturn_nepal

# ── JWT (generate with: openssl rand -hex 32) ────────────
JWT_SECRET=change-me-min-32-chars
JWT_ACCESS_EXPIRE=15m
JWT_REFRESH_EXPIRE=7d

# ── Redis (optional; app falls back to Mongo if absent) ──
REDIS_URL=redis://localhost:6379

# ── Cloudinary (image upload) ────────────────────────────
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# ── Email (Gmail SMTP — use an App Password, not your login) ──
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-gmail-app-password
EMAIL_FROM=PageTurn Nepal <noreply@pageturn.com.np>

# ── SEO / IndexNow (generate a random key before prod) ───
INDEXNOW_KEY=

# ── Security ─────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
