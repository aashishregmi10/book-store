# ── Server ───────────────────────────────────────────────
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# ── MongoDB ──────────────────────────────────────────────
# Local:  mongodb://localhost:27017/bookstemple_nepal
# Atlas:  mongodb+srv://<user>:<password>@<cluster>.mongodb.net/bookstemple_nepal?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/bookstemple_nepal
# Optional. Comma-separated DNS servers for resolving mongodb+srv:// SRV records.
# Set this if Node's resolver is loopback-only (VPN/Docker/local proxy) and
# Atlas connects fail with "querySrv ECONNREFUSED". e.g. 8.8.8.8,1.1.1.1
# DNS_SERVERS=8.8.8.8,1.1.1.1

# ── JWT (generate with: openssl rand -hex 32) ────────────
JWT_SECRET=change-me-min-32-chars
JWT_ACCESS_EXPIRE=15m
JWT_REFRESH_EXPIRE=7d

# ── Redis (optional; app falls back to Mongo if absent) ──
REDIS_URL=redis://localhost:6379

# ── Cloudinary (image upload) ────────────────────────────
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# ── Email (Gmail SMTP — use an App Password, not your login) ──
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-gmail-app-password
EMAIL_FROM=Books Temple Nepal <noreply@bookstemplenepal.com>

# ── Google OAuth (Sign in with Google) ──────────────────
# The public Web client ID from Google Cloud Console (only this is needed —
# ID-token verification doesn't use the client secret).
GOOGLE_CLIENT_ID=

# ── Book metadata lookup (Google Books) ─────────────────
# Optional but recommended: the keyless Google Books quota is tiny and 429s under
# load, which breaks bulk lookups. Create a key in Google Cloud Console (Books
# API) and paste it here. Open Library needs no key.
GOOGLE_BOOKS_API_KEY=

# ── New Relic APM (optional; only runs when NODE_ENV=production) ──
NEW_RELIC_LICENSE_KEY=
NEW_RELIC_APP_NAME=Books Temple Nepal API

# ── SEO / IndexNow (generate a random key before prod) ───
INDEXNOW_KEY=

# ── Security ─────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
